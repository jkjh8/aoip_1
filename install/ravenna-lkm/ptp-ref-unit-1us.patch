+/* REF_UNIT = 1 microsecond (2026-09-17 변경: 원래 100us)
+ * 원래 100us 였는데 ktime_get() 의 ns 해상도를 여기서 버리는 바람에
+ * TIC 스케줄 / PTP T1,T2 / SAC 계산이 전부 100us = 4.8프레임@48k 로 양자화됐다.
+ * 실측: 개별 TIC 위상이 4.8fr 단위(9.8/14.3fr)로 튀고, 이것이 in_ring 비트
+ * 현상의 관측 노이즈 바닥(±4.8fr)이자 TIC 축소(F<48)를 막는 벽이었다.
+ * 1us 로 내리면 양자화가 0.048프레임이 된다.
+ * 주의: 시간값이 100배 커지므로, REF_UNIT 을 샘플/us 로 환산하는 자리는
+ * 아래 파생 상수를 쓸 것 (배율 하드코딩 금지). */
+#define PS_2_REF_UNIT 1000000   // ps -> REF_UNIT
+#define NS_2_REF_UNIT 1000      // ns -> REF_UNIT (linux time unit)
+#define REF_UNIT_PER_SEC (1000000000ull / NS_2_REF_UNIT)  // 초당 REF_UNIT 수
+#define REF_UNIT_2_US    (NS_2_REF_UNIT / 1000)           // REF_UNIT -> us
+
+/* PTP sync 워치독 — REF_UNIT 단위로 비교되므로 반드시 REF_UNIT 기준으로 환산할 것.
+ * (원본은 100us 전용으로 20000 이 하드코딩돼 있었고, REF_UNIT 을 1us 로 바꾸면
+ *  2s → 20ms 가 되어 sync 도착 전에 워치독이 터진다. 2026-09-17 실증) */
+#define PTP_WATCHDOG_ELAPSE  (2ull * REF_UNIT_PER_SEC)  // sync 최소 2s 마다 수신 가정
+
+/* t[REF_UNIT] → 샘플 수.
+ * ui64T1 은 PTP epoch(TAI, ~1.8e9 s) 기반이라 REF_UNIT 이 작아지면 값이 매우 커진다.
+ * t * rate 를 그냥 곱하면 uint64 가 넘친다 (1us 기준 1.8e15 * 48000 = 8.6e19 > 1.8e19).
+ * 초/나머지로 쪼개서 곱한다. 원식 (t * rate / REF_UNIT_PER_SEC) 과 결과 동일. */
+static inline uint64_t ref_unit_to_samples(uint64_t t, uint32_t ui32Rate)
+{
+    return (t / REF_UNIT_PER_SEC) * ui32Rate
+         + ((t % REF_UNIT_PER_SEC) * ui32Rate) / REF_UNIT_PER_SEC;
+}
 
