[Unit]
Description=AoIP Backend
After=network-online.target aoip-soundcard.service aes67-daemon.service
Wants=network-online.target
Requires=aoip-soundcard.service aes67-daemon.service

[Service]
Type=simple
User=kjh
Group=audio
WorkingDirectory=/home/kjh/aoip_1
Environment=PATH=/home/kjh/.nvm/versions/node/v24.14.1/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do [ -c /dev/snd/pcmC0D0p ] && amixer -D hw:aoip info >/dev/null 2>&1 && exit 0; sleep 1; done; exit 1'
ExecStart=/home/kjh/.nvm/versions/node/v24.14.1/bin/node --max-old-space-size=128 index.js
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=5
SendSIGKILL=yes
RuntimeDirectory=aoip
RuntimeDirectoryPreserve=yes
LimitRTPRIO=99
LimitMEMLOCK=infinity
Nice=-5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aoip
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
