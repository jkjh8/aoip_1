[Unit]
Description=PHC ↔ System Clock Sync (AES67)
After=ptp4l.service network-online.target
Requires=ptp4l.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/phc2sys-freqonly.sh
Restart=on-failure
RestartSec=3
User=root
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=79
CPUAffinity=1
OOMScoreAdjust=-900
LimitRTPRIO=infinity
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
