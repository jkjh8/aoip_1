[Unit]
Description=PTP TAI Sync (PHC freq → CLOCK_REALTIME + tick reset)
After=ptp4l.service
Requires=ptp4l.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/ptp-tai-sync /dev/ptp0
Restart=on-failure
RestartSec=5
User=root
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=46
CPUAffinity=1
OOMScoreAdjust=-900

[Install]
WantedBy=multi-user.target
